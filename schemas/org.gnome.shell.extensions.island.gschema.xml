<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="island@caionazario.dev">
  <enum id="org.gnome.shell.extensions.island.ClickAction">
    <value nick="center-card" value="0"/>
    <value nick="calendar" value="1"/>
  </enum>
  <schema id="org.gnome.shell.extensions.island" path="/org/gnome/shell/extensions/island/">
    <key name="click-action" enum="org.gnome.shell.extensions.island.ClickAction">
      <default>'center-card'</default>
      <summary>Clique na ilha abre</summary>
    </key>
    <key name="weather-location" type="v">
      <default>&lt;@mv nothing&gt;</default>
      <summary>Cidade do clima</summary>
      <description>Localização GWeather serializada (GWeather.Location.serialize); vazio segue a cadeia de localização.</description>
    </key>
    <key name="weather-hint-shown" type="b">
      <default>false</default>
      <summary>Dica de configurar a cidade já foi mostrada</summary>
    </key>
    <key name="ai-claude-enabled" type="b">
      <default>true</default>
      <summary>Mostrar o uso do Claude</summary>
    </key>
    <key name="ai-codex-enabled" type="b">
      <default>true</default>
      <summary>Mostrar o uso do Codex</summary>
    </key>
  </schema>
</schemalist>

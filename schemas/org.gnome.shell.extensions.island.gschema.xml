<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="island@caionazario.dev">
  <enum id="org.gnome.shell.extensions.island.ClickAction">
    <value nick="center-card" value="0"/>
    <value nick="calendar" value="1"/>
  </enum>
  <schema id="org.gnome.shell.extensions.island" path="/org/gnome/shell/extensions/island/">
    <key name="click-action" enum="org.gnome.shell.extensions.island.ClickAction">
      <default>'center-card'</default>
      <summary>Clique na ilha abre</summary>
    </key>
    <key name="weather-location" type="v">
      <default>&lt;@mv nothing&gt;</default>
      <summary>Cidade do clima</summary>
      <description>Localização GWeather serializada (GWeather.Location.serialize); vazio segue a cadeia de localização.</description>
    </key>
    <key name="weather-hint-shown" type="b">
      <default>false</default>
      <summary>Dica de configurar a cidade já foi mostrada</summary>
    </key>
    <key name="ai-claude-enabled" type="b">
      <default>true</default>
      <summary>Mostrar o uso do Claude</summary>
    </key>
    <key name="ai-codex-enabled" type="b">
      <default>true</default>
      <summary>Mostrar o uso do Codex</summary>
    </key>
    <key name="prefs-page" type="s">
      <default>''</default>
      <summary>Página a abrir nas preferências</summary>
      <description>Interna: a extensão grava o nome da página antes de abrir a janela, que mostra essa página e zera a chave.</description>
    </key>
    <key name="environments" type="a(ssasas)">
      <default>[('Padrão', 'house', ['ai'], ['hw']), ('Trabalho', 'briefcase', ['event', 'pomodoro', 'ai'], ['hw', 'github']), ('Estudos', 'book-open', ['progress', 'pomodoro'], ['note']), ('Fim de semana', 'sun-horizon', ['music'], ['countdown'])]</default>
      <summary>Ambientes</summary>
      <description>Nome, ícone (glifo Phosphor), widgets da pílula esquerda e da direita. O primeiro é o Padrão.</description>
    </key>
    <key name="environment-index" type="u">
      <default>0</default>
      <summary>Ambiente ativo</summary>
    </key>
    <key name="switch-environment-next" type="as">
      <default>['&lt;Super&gt;&lt;Control&gt;Right']</default>
      <summary>Próximo ambiente</summary>
    </key>
    <key name="switch-environment-previous" type="as">
      <default>['&lt;Super&gt;&lt;Control&gt;Left']</default>
      <summary>Ambiente anterior</summary>
    </key>
    <key name="countdown-name" type="s">
      <default>''</default>
      <summary>Nome da contagem regressiva</summary>
    </key>
    <key name="countdown-date" type="s">
      <default>''</default>
      <summary>Data da contagem regressiva</summary>
      <description>AAAA-MM-DD; vazio é sem data.</description>
    </key>
    <key name="note-text" type="s">
      <default>''</default>
      <summary>Nota da barra</summary>
      <description>Até 80 caracteres, sem quebra de linha; editada na ilha.</description>
    </key>
    <key name="pomodoro-state" type="s">
      <default>''</default>
      <summary>Estado do pomodoro</summary>
      <description>Interna: fase e tempo restante em JSON, sempre pausado; vazio é Foco 25:00.</description>
    </key>
  </schema>
</schemalist>
